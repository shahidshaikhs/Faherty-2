      "label": "Logo alt text",
      "default": "Welcome to Australia"
    },
    {
      "type": "number",
      "id": "logo_max_width",
      "label": "Logo max width",
      "default": 300
    },
    {
      "type": "number",
      "id": "logo_max_width_mobile",
      "label": "Logo max width mobile",
      "default": 260
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "MEN'S NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "WOMEN'S NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "section_height_desktop",
      "label": "Section height desktop",
      "default": 640
    },
    {
      "type": "number",
      "id": "section_height_mobile",
      "label": "Section height mobile",
      "default": 520
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_video_toggle",
      "label": "Show video toggle",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_video"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
