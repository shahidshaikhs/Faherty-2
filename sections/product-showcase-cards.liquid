{%- liquid
  assign overlay_color_rgb = section.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' | strip
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<div
  id="ProductShowcaseCards-{{ section.id }}"
  class="product-showcase-cards color-{{ section.settings.color_scheme }} spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div
    class="product-showcase-cards__grid"
    data-testid="product-showcase-cards-grid"
  >
    {%- for block in section.blocks -%}
      {%- if block.type == 'card' -%}
        <div
          class="product-showcase-cards__card"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- assign sizes_val = '(min-width: 750px) 50vw, 100vw' -%}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                sizes: sizes_val,
                widths: '375,550,750,1100,1500,1780,2000',
                loading: 'lazy',
                class: 'product-showcase-cards__image',
                alt: block.settings.image.alt
            }}
          {%- else -%}
            <div class="product-showcase-cards__placeholder">
              {{ 'image' | placeholder_svg_tag: 'product-showcase-cards__placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="product-showcase-cards__overlay"></div>

          <div class="product-showcase-cards__content">
            {%- if block.settings.heading != blank -%}
              <p class="product-showcase-cards__heading">
                {{- block.settings.heading | escape -}}
              </p>
            {%- endif -%}

            {%- if block.settings.button_text != blank -%}
              {%- if block.settings.button_link != blank -%}
                <a
                  href="{{ block.settings.button_link }}"
                  class="product-showcase-cards__cta"
                >
                  {{- block.settings.button_text | escape -}}
                </a>
              {%- else -%}
                <span class="product-showcase-cards__cta">
                  {{- block.settings.button_text | escape -}}
                </span>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% style %}
  #ProductShowcaseCards-{{ section.id }} {
    --card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --overlay-color-rgb: {{ overlay_color_rgb }};
    --overlay-opacity: {{ overlay_opacity }};
    --cards-gap: {{ section.settings.gap }}px;
  }
{% endstyle %}

{% stylesheet %}
  .product-showcase-cards {
    position: relative;
  }

  .product-showcase-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cards-gap, 0px);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .product-showcase-cards__card {
    position: relative;
    overflow: hidden;
    height: var(--card-height-mobile, 520px);

    @media screen and (min-width: 750px) {
      height: var(--card-height-desktop, 960px);
    }
  }

  .product-showcase-cards__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-showcase-cards__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(242, 242, 242);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-showcase-cards__placeholder-svg {
    width: 50%;
    height: 50%;
  }

  .product-showcase-cards__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(var(--overlay-color-rgb), var(--overlay-opacity));
    pointer-events: none;
  }

  .product-showcase-cards__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .product-showcase-cards__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-align: center;
    color: rgb(255, 255, 255);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 24px;
    }
  }

  .product-showcase-cards__cta {
    display: inline-block;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.28;
    color: rgb(255, 255, 255);
    text-decoration: none;
    text-align: center;
    margin-block-start: 36px;
    pointer-events: auto;
    position: relative;
    padding-block-end: 9px;

    @media screen and (min-width: 750px) {
      font-size: 16px;
    }
  }

  .product-showcase-cards__cta::after {
    content: '';
    display: block;
    position: absolute;
    inset-inline-start: 0;
    inset-inline-end: 0;
    inset-block-end: 0;
    height: 1px;
    background-color: rgb(255, 255, 255);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_showcase_cards",
  "tag": "section",
  "class": "product-showcase-cards-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "card_height_desktop",
      "label": "Card height (desktop)",
      "default": 960
    },
    {
      "type": "number",
      "id": "card_height_mobile",
      "label": "Card height (mobile)",
      "default": 520
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 48,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#1e2020"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.showcase_card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.product_showcase_cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Collection Name"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Collection Name"
          }
        }
      ]
    }
  ]
}
{% endschema %}
