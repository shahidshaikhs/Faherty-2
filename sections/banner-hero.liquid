{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile
  assign lockup_image = section.settings.lockup_image
  assign lockup_alt = section.settings.lockup_alt | escape
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

<div
  id="BannerHero-{{ section.id }}"
  class="banner-hero color-{{ section.settings.color_scheme }} spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if has_link -%}
    <a href="{{ section.settings.link }}" class="banner-hero__link" aria-label="{{ lockup_alt }}"></a>
  {%- endif -%}

  <div class="banner-hero__media">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 390 }} 390w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: desktop_image.width
          | image_tag:
            sizes: '100vw',
            widths: '375,750,1100,1440,1780,2000',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'banner-hero__image',
            alt: lockup_alt
        }}
      </picture>
    {%- endif -%}
  </div>

  {%- if section.settings.toggle_overlay -%}
    <div class="banner-hero__overlay"></div>
  {%- endif -%}

  <div class="banner-hero__content">
    {%- if lockup_image != blank -%}
      {{ lockup_image | image_url: width: 1000 | image_tag: class: 'banner-hero__lockup', alt: lockup_alt, loading: 'eager' }}
    {%- else -%}
      <img
        src="{{ 'lockup-c05c2c912789.svg' | asset_url }}"
        alt="{{ lockup_alt }}"
        class="banner-hero__lockup"
        loading="eager"
        width="512"
        height="91"
      >
    {%- endif -%}
  </div>
</div>

{% style %}
  #BannerHero-{{ section.id }} {
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --lockup-max-width: {{ section.settings.lockup_max_width }}px;
  }
{% endstyle %}

{% stylesheet %}
  .banner-hero {
    position: relative;
    overflow: hidden;
  }

  .banner-hero__link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .banner-hero__media {
    position: absolute;
    inset: 0;
  }

  .banner-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  .banner-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100%;
    pointer-events: none;
  }

  .banner-hero__lockup {
    display: block;
    max-width: var(--lockup-max-width, 500px);
    width: 100%;
    height: auto;
    margin-block: 32px;
  }

  @media screen and (max-width: 749px) {
    .banner-hero__lockup {
      max-width: calc(var(--lockup-max-width, 500px) * 0.7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.banner_hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:settings.desktop_image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.mobile_image"
    },
    {
      "type": "header",
      "content": "t:content.logo"
    },
    {
      "type": "image_picker",
      "id": "lockup_image",
      "label": "t:settings.lockup_image",
      "info": "t:info.lockup_image_info"
    },
    {
      "type": "text",
      "id": "lockup_alt",
      "label": "t:settings.lockup_alt",
      "default": "The Unofficial Summer Kickoff"
    },
    {
      "type": "number",
      "id": "lockup_max_width",
      "label": "t:settings.lockup_max_width",
      "default": 500
    },
    {
      "type": "header",
      "content": "t:content.section_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link_url"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "#000000",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.banner_hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
