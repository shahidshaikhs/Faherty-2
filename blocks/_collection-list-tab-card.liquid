{% doc %}
  Collection list tab card

  A leaf block representing a single collection card inside a tab panel.
  Renders as a link with an image and label.

  @param {Object} block - The block object with settings for image, label, and link

  @example
  {% content_for 'block', type: '_collection-list-tab-card', id: 'card-1' %}
{% enddoc %}

{%- liquid
  assign card_image = block.settings.image
  assign card_label = block.settings.label
  assign card_link = block.settings.link | default: '#'
-%}

<a
  {{ block.shopify_attributes }}
  href="{{ card_link }}"
  class="collection-list-tabs__card"
  data-testid="collection-list-tab-card"
>
  <div class="collection-list-tabs__card-media">
    {%- if card_image != blank -%}
      {%- assign sizes_val = '(min-width: 750px) 33vw, 80vw' -%}
      {{
        card_image
        | image_url: width: card_image.width
        | image_tag:
          sizes: sizes_val,
          widths: '300,450,600,900',
          loading: 'lazy',
          class: 'collection-list-tabs__card-image',
          alt: card_image.alt | default: card_label
      }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'collection-list-tabs__card-placeholder' }}
    {%- endif -%}
  </div>
  {%- if card_label != blank -%}
    <div class="collection-list-tabs__card-content">
      <p class="collection-list-tabs__card-label">{{ card_label | escape }}</p>
    </div>
  {%- endif -%}
</a>

{% schema %}
{
  "name": "t:names.collection_list_tab_card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list_tab_card"
    }
  ]
}
{% endschema %}
