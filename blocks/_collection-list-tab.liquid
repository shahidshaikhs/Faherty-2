{% doc %}
  Collection list tab

  A container block representing a single tab panel. Contains child
  _collection-list-tab-card blocks rendered via content_for 'blocks'.

  @param {Object} block - The block object with tab_label setting

  @example
  {% content_for 'block', type: '_collection-list-tab', id: 'tab-1' %}
{% enddoc %}

<div
  {{ block.shopify_attributes }}
  class="collection-list-tabs__panel"
  id="panel-{{ block.id }}"
  role="tabpanel"
  ref="panel"
  data-testid="collection-list-tab-panel"
  data-tab-label="{{ block.settings.tab_label | escape }}"
  hidden
>
  <div class="collection-list-tabs__scroll-area" ref="scrollArea">
    <div class="collection-list-tabs__cards">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.collection_list_tab",
  "tag": null,
  "blocks": [
    {
      "type": "_collection-list-tab-card"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "tab_label",
      "label": "t:settings.tab_label",
      "default": "Tab"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list_tab"
    }
  ]
}
{% endschema %}
